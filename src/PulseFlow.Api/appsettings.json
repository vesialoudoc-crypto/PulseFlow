{
  "Ingestion": {
    "ChunkCapacity": 100,
    "MaxBatchBytes": 10485760
  },
  "RabbitMq": {
    "QueueName": "pulseflow.ingestion-batches",
    "ConsumerCount": 1,
    "PublisherChannelCount": 4,
    "ConnectionTimeout": "00:00:10",
    "HandshakeTimeout": "00:00:10",
    "ContinuationTimeout": "00:00:10",
    "TopologyDeclarationTimeout": "00:00:10",
    "PublisherChannelTimeout": "00:00:05",
    "PublishConfirmationTimeout": "00:00:05",
    "CleanupTimeout": "00:00:01"
  },
  "PostgreSql": {
    "ConnectionTimeout": "00:00:10",
    "CommandTimeout": "00:00:10"
  },
  "Redis": {
    "ConnectTimeout": "00:00:10",
    "AsyncTimeout": "00:00:01"
  },
  "Startup": {
    "InitializationTimeout": "00:00:30"
  },
  "HealthChecks": {
    "Timeout": "00:00:02"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
