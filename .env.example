# Local AWS staging bootstrap. Copy to .env and replace every placeholder.
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1

GHCR_USERNAME=<github-username>
GHCR_TOKEN=<github-packages-read-token>

#----------------------------------------APP-----------------------------------------

PULSEFLOW_IMAGE=ghcr.io/<repository-owner>/pulseflow-api:sha-<40-lowercase-hex-characters>

PULSEFLOW_POSTGRES_HOST=<postgres-private-ip>
PULSEFLOW_POSTGRES_DB=pulseflow
PULSEFLOW_POSTGRES_USER=pulseflow
PULSEFLOW_POSTGRES_PASSWORD=<generated-safe-postgresql-password>

PULSEFLOW_RABBITMQ_HOST=<rabbitmq-private-ip>
PULSEFLOW_RABBITMQ_USER=pulseflow
PULSEFLOW_RABBITMQ_PASSWORD=<generated-safe-rabbitmq-password>

PULSEFLOW_REDIS_HOST=<redis-private-ip>
