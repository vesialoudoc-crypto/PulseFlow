# Local AWS staging bootstrap. Copy to .env and replace every placeholder.
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1

GHCR_USERNAME=<github-username>
GHCR_TOKEN=<github-packages-read-token>

PULSEFLOW_IMAGE=ghcr.io/<repository-owner>/pulseflow-api:sha-<40-lowercase-hex-characters>
