# Normal local staging planning uses the repository-root .env and
# scripts/deploy-aws-managed-legacy.ps1, not this file. This is only a reference for an
# operator who deliberately runs Terraform directly. Never put a GHCR token here.

# aws_profile is optional. Leave it unset to use normal AWS_* environment-variable
# credential discovery.
# aws_profile = "optional-profile-name"

pulseflow_image = "ghcr.io/<repository-owner>/pulseflow-api:sha-<40-lowercase-hex-characters>"

# Create this secret outside Terraform before the first plan. It contains only:
# {"username":"<github-user>","password":"<package-read-token>"}
ghcr_registry_credentials_secret_arn = "arn:aws:secretsmanager:eu-central-1:<account-id>:secret:pulseflow-staging/bootstrap/ghcr-<suffix>"
