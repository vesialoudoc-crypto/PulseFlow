#!/usr/bin/env bash
set -euo pipefail

cd /opt/pulseflow
umask 077

postgres_secret="$(aws secretsmanager get-secret-value --region '${aws_region}' --secret-id '${postgres_secret_arn}' --query SecretString --output text)"
rabbitmq_secret="$(aws secretsmanager get-secret-value --region '${aws_region}' --secret-id '${rabbitmq_secret_arn}' --query SecretString --output text)"
ghcr_secret="$(aws secretsmanager get-secret-value --region '${aws_region}' --secret-id '${ghcr_secret_arn}' --query SecretString --output text)"

postgres_username="$(jq --raw-output '.username' <<<"$postgres_secret")"
postgres_password="$(jq --raw-output '.password' <<<"$postgres_secret")"
rabbitmq_username="$(jq --raw-output '.username' <<<"$rabbitmq_secret")"
rabbitmq_password="$(jq --raw-output '.password' <<<"$rabbitmq_secret")"
ghcr_username="$(jq --raw-output '.username' <<<"$ghcr_secret")"
ghcr_password="$(jq --raw-output '.password' <<<"$ghcr_secret")"

cat > .env <<EOF
POSTGRES_USERNAME=$postgres_username
POSTGRES_PASSWORD=$postgres_password
POSTGRES_PRIVATE_IP=${postgres_private_ip}
RABBITMQ_USERNAME=$rabbitmq_username
RABBITMQ_PASSWORD=$rabbitmq_password
RABBITMQ_PRIVATE_IP=${rabbitmq_private_ip}
REDIS_PRIVATE_IP=${redis_private_ip}
EOF
chmod 0600 .env

printf '%s' "$ghcr_password" | docker login ghcr.io --username "$ghcr_username" --password-stdin
docker compose pull
docker logout ghcr.io

# This is intentionally separate from API startup: a nonzero migration result prevents
# either replica from being started with a pending schema change.
docker compose run --rm --no-deps migrations
docker compose up -d api-1 api-2 haproxy
