import http from 'k6/http';

const baseUrl = __ENV.BASE_URL || 'http://${app_private_ip}';
const eventId = __ENV.SMOKE_EVENT_ID;

if (!eventId) {
    throw new Error('SMOKE_EVENT_ID is required.');
}

export function setup() {
    const readiness = http.get(`$${baseUrl}/health/ready`);

    if (readiness.status !== 200) {
        throw new Error(`Readiness expected HTTP 200 but received $${readiness.status}.`);
    }
}

export default function () {
    const event = {
        eventId,
        type: 'infrastructure.smoke',
        source: 'ec2-smoke',
        occurredAt: new Date().toISOString(),
        payload: {
            scenario: 'ec2-performance-environment-smoke',
        },
    };

    const response = http.post(`$${baseUrl}/api/events`, `$${JSON.stringify(event)}\n`, {
        headers: {
            'Content-Type': 'application/x-ndjson',
        },
    });

    if (response.status !== 202) {
        throw new Error(`Ingestion expected HTTP 202 but received $${response.status}.`);
    }
}
