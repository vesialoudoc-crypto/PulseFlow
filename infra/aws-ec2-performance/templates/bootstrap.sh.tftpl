#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/pulseflow-bootstrap.log) 2>&1

dnf install -y docker curl jq
systemctl enable --now docker amazon-ssm-agent

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --location --retry 5 --silent --show-error \
  "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

install -d -m 0755 /opt/pulseflow/scripts
echo '${compose_file_base64}' | base64 --decode > /opt/pulseflow/docker-compose.yml
chmod 0644 /opt/pulseflow/docker-compose.yml

%{ for file_name, file_content in helper_files ~}
install -d -m 0755 "$(dirname "/opt/pulseflow/${file_name}")"
echo '${file_content}' | base64 --decode > "/opt/pulseflow/${file_name}"
chmod 0700 "/opt/pulseflow/${file_name}"
%{ endfor ~}

touch /opt/pulseflow/.bootstrap-complete
